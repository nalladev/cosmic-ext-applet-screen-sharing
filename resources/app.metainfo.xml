  <url
        type="vcs-browser"
    >https://github.com/nalladev/cosmic-ext-applet-screen-sharing</url>
  <launchable
        type="desktop-id"
    >io.github.nalladev.cosmic-ext-applet-screen-sharing.desktop</launchable>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-ext-applet-screen-sharing</binary>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <categories>
