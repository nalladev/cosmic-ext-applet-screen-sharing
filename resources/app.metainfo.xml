<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>io.github.nalladev.cosmic-ext-applet-screen-sharing</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <name>Screen Sharing</name>
  <developer id="com.github.nalladev">
    <name>Joel</name>
    <url type="homepage">https://github.com/nalladev</url>
  </developer>
  <summary>Screen sharing applet for COSMIC desktop</summary>
  <description>
    <p>
      Share your screen to wired displays and wireless receivers from a single
      place in the panel. Detect connected displays and FCast receivers, then
      choose what to share and where.
    </p>
    <ul>
      <li>Detect displays connected via HDMI, VGA, or DisplayPort</li>
      <li>Discover FCast receivers on the network</li>
      <li>Share the entire screen or a single window</li>
    </ul>
  </description>
  <icon
        type="stock"
    >io.github.nalladev.cosmic-ext-applet-screen-sharing-symbolic</icon>
  <url
        type="homepage"
    >https://github.com/nalladev/cosmic-ext-applet-screen-sharing</url>
  <url
        type="bugtracker"
